LEMS_IMAGE=ghcr.io/abrance/ems
LEMS_IMAGE_TAG=v1.0.0
LEMS_PORT=80
APP_PROFILE=prod
EMSDEVICE_IMAGE=ghcr.io/abrance/emsdevice
EMSDEVICE_IMAGE_TAG=v1.0.0
EMSDEVICE_PORT=1502
EMSDEVICE_MOCK=live
EMSDEVICE_MOCK_INTERVAL=1s
EMSDEVICE_MOCK_SOC=80
EMSDEVICE_MOCK_POWER=5

# 初始口令（仅新建库时写入；留空 = 出厂默认 admin / 111111，已有库不受影响）
EMS_ADMIN_PASSWORD=
EMS_USER_PASSWORD=

# 外部数据源/存储地址（留空则对应功能不启动，仓库不内置）
PRICE_SYNC_BASE_URL=
HOME_MARKET_GATEWAY_BASE=
GD_METRIC_URL=
SPOT_REPORT_WECHAT_HOST=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_ZONE=z2
