# 集成测试环境配置模板：复制为 .env.integration 后填写。
# 该文件会被 shell 直接 source，含空格/括号/&/? 的值必须用双引号括起来。
# 该文件入库；.env.integration 已被 git 忽略，凭证绝不提交。
# 脚本只连接这里配置的中间件，不负责启动/停止它们。

# 环境标识：local / dev / ci；prod 会被脚本拒绝
TEST_ENV="local"

# 日志级别：debug / info / warn / error
LOG_LEVEL="warn"

# 数据库：sqlite / mysql / postgres
TEST_DB_DRIVER="mysql"
# sqlite 填文件路径；mysql 形如 user:pass@tcp(127.0.0.1:3306)/dbname?charset=utf8mb4&parseTime=true&loc=Local
TEST_DB_DSN="root:root@tcp(127.0.0.1:3306)/ems_it?charset=utf8mb4&parseTime=true&loc=Local"
# mysql/postgres 用于隔离的测试库名（脚本会校验它不是生产库）
TEST_DB_SCHEMA="ems_it"

# 场景需要时才填
TEST_REDIS_ADDR="127.0.0.1:6379"
TEST_REDIS_DB="15"
TEST_MQTT_BROKER="tcp://127.0.0.1:1883"
TEST_MODBUS_TCP_ADDR="127.0.0.1:502"
# 端到端场景访问的运行实例（需自行启动应用）
TEST_HTTP_BASE_URL="http://127.0.0.1:15880"

# 运行参数
TEST_TIMEOUT="10m"
TEST_ARTIFACT_DIR="out/test-artifacts"
